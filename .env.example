# このファイルをコピーして .env を作る（.env は gitignore されている）
#   cp .env.example .env
# compose.yml が .env を読み込むので、書き換えたら docker compose restart web

# --- Google Maps Platform（病院＆ペットホテル検索） ---
# 用途ごとに2つに分ける。同じキーを使い回さない。
# サーバー用：Geocoding API / Places API (New) を呼ぶ。HTMLには出ないので制限なし
GOOGLE_MAPS_SERVER_KEY=
# ブラウザ用：地図の埋め込み（Maps Embed API）。HTMLに書かれるので
# 「HTTPリファラー」で自分のドメインだけに制限する
GOOGLE_MAPS_BROWSER_KEY=

# --- Googleアカウントでのログイン ---
# Google Cloud の「APIとサービス → 認証情報 → OAuth クライアント ID（ウェブアプリケーション）」で作る。
# 承認済みのリダイレクトURIに、開発用と本番用の両方を登録しておく：
#   http://localhost:3000/users/auth/google_oauth2/callback
#   https://sotusei.onrender.com/users/auth/google_oauth2/callback
# ここが空のときは、ログイン画面に Google のボタンを出さない
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- メール送信 ---
# 開発環境は delivery_method = :file なので、送らずに tmp/mails へ書き出す。
# ここが空でも開発はできる。
RESEND_API_KEY=
# 差出人。Resend で所有を確認したドメインのアドレスにする
MAILER_FROM=
# お問い合わせの通知先。打ち間違えるとログ上は成功のまま届かないので注意
ADMIN_EMAIL=

# --- 画像の保存先（本番のみ） ---
# 開発・テストは Disk（storage/ 配下）。本番だけ Cloudinary を使う。
# cloudinary gem がこの名前の環境変数を自動で読む
# CLOUDINARY_URL=cloudinary://APIキー:APIシークレット@クラウド名
