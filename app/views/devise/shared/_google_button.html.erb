<%# Googleアカウントでログインするボタン。ログイン画面と新規登録画面で共通して使う。
    キーを設定していない環境（CIなど）では押しても始まらないので、そのときは出さない。

    method: :post が必須。omniauth-rails_csrf_protection が GET での開始を弾くため。
    locals: label %>
<% if ENV["GOOGLE_CLIENT_ID"].present? %>
  <div class="my-md">
    <%# 「または」の区切り線 %>
    <div class="flex items-center gap-3 mb-md" aria-hidden="true">
      <span class="h-px flex-1 bg-outline-variant"></span>
      <span class="font-label-sm text-label-sm text-on-surface-variant/70">または</span>
      <span class="h-px flex-1 bg-outline-variant"></span>
    </div>

    <%= button_to user_google_oauth2_omniauth_authorize_path, data: { turbo: false },
          class: "w-full h-[48px] flex items-center justify-center gap-3 rounded-full bg-surface border border-outline-variant font-label-md text-label-md text-on-surface hover:bg-surface-container-low transition-colors cursor-pointer" do %>
      <%# Googleのロゴ（4色のG）。ブランドの指定どおりの色で描いている %>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.91c1.7-1.57 2.69-3.88 2.69-6.62z"/>
        <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.91-2.26c-.81.54-1.84.86-3.05.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
        <path fill="#FBBC05" d="M3.97 10.72A5.41 5.41 0 0 1 3.68 9c0-.6.1-1.18.29-1.72V4.95H.96A9 9 0 0 0 0 9c0 1.45.35 2.82.96 4.05l3.01-2.33z"/>
        <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.59C13.46.89 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
      </svg>
      <%= label %>
    <% end %>

    <p class="font-label-sm text-label-sm text-on-surface-variant/70 mt-2 text-center">
      お名前とメールアドレスだけをお預かりします
    </p>
  </div>
<% end %>
