<%# 自分がした質問の一覧 %>
<div class="flex flex-col gap-3">
  <% items.each do |question| %>
    <%= link_to question_path(question), class: "block bg-surface-container-lowest rounded-xl p-5 shadow-sm hover:shadow-md transition-all" do %>
      <div class="flex items-center justify-between gap-2 mb-2">
        <span class="inline-block px-2 py-1 rounded bg-secondary-container text-on-secondary-container font-label-sm text-label-sm shrink-0">
          <%= question.category %>
        </span>
        <span class="font-label-sm text-label-sm text-outline shrink-0"><%= posted_at(question.created_at) %></span>
      </div>

      <h2 class="font-headline-sm text-headline-sm text-on-surface line-clamp-2 mb-1"><%= question.title %></h2>
      <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2"><%= question.content %></p>

      <div class="flex items-center gap-4 mt-3 font-label-sm text-label-sm text-on-surface-variant">
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">forum</span><%= question.answers.size %>
        </span>
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">pets</span><%= question.likes.size %>
        </span>
      </div>
    <% end %>
  <% end %>
</div>
